---
import type { Props } from '@astrojs/starlight/props';
import VersionBadge from './VersionBadge.astro';
---

<div class="site-title-wrapper sl-flex">
  <a href="/" class="site-title sl-flex">
    <span class="brand-text">SolidRusT<span class="brand-accent">.ai</span></span>
  </a>
  <VersionBadge />
</div>

<style>
  .site-title-wrapper {
    display: flex;
    align-items: center;
    gap: 0;
  }

  .site-title {
    text-decoration: none;
    gap: 0.5rem;
    align-items: center;
  }

  .brand-text {
    font-family: 'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--sl-color-text);
  }

  .brand-accent {
    color: #C96A32;
  }

  :global([data-theme='dark']) .brand-text {
    color: #F2EDE6;
  }

  :global([data-theme='light']) .brand-text,
  :global(:root:not([data-theme='dark'])) .brand-text {
    color: #11161B;
  }
</style>
